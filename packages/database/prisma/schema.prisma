generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  type      String
  status    String   @default("active")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  roles   Role[]
  objects RosObject[]
  events  TimelineEvent[]

  communications       Communication[]
  communicationReviews CommunicationReviewItem[]
  importCheckpoints    ImportCheckpoint[]
}

model User {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String   @unique
  roleId      String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  role      Role?     @relation(fields: [roleId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  users     User[]
}

model RosObject {
  id          String    @id @default(cuid())
  workspaceId String
  objectType  String
  name        String
  status      String
  health      String
  ownerId     String?
  nextAction  String?
  data        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  events      TimelineEvent[]
  sourceLinks ObjectRelationship[] @relation("source")
  targetLinks ObjectRelationship[] @relation("target")

  communications                Communication[]
  suggestedCommunicationReviews CommunicationReviewItem[] @relation("suggestedWorkItem")
}

model ObjectRelationship {
  id               String   @id @default(cuid())
  sourceObjectId   String
  targetObjectId   String
  relationshipType String
  createdAt        DateTime @default(now())

  sourceObject RosObject @relation("source", fields: [sourceObjectId], references: [id])
  targetObject RosObject @relation("target", fields: [targetObjectId], references: [id])
}

model TimelineEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  objectId      String
  actorId       String?
  eventType     String
  summary       String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  object    RosObject @relation(fields: [objectId], references: [id])
}

model Workflow {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  status       String
  triggerEvent String
  definition   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowId   String
  objectId     String
  status       String
  currentStage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

model Task {
  id              String    @id @default(cuid())
  workspaceId     String
  relatedObjectId String?
  ownerId         String?
  title           String
  status          String
  priority        String
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AutomationRule {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  triggerEvent   String
  conditions     Json
  actions        Json
  requiresReview Boolean  @default(false)
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String?
  relatedObjectId String?
  level           String
  title           String
  message         String
  status          String
  dueAt           DateTime?
  createdAt       DateTime  @default(now())
}

model Document {
  id              String   @id @default(cuid())
  workspaceId     String
  relatedObjectId String?
  fileName        String
  fileUrl         String
  documentType    String
  status          String
  createdAt       DateTime @default(now())
}

model Invoice {
  id              String    @id @default(cuid())
  workspaceId     String
  clientObjectId  String
  relatedObjectId String?
  packageObjectId String?
  amount          Decimal
  status          String
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  invoiceId   String
  amount      Decimal
  status      String
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Communication {
  id                String    @id @default(cuid())
  workspaceId       String
  source            String
  externalMessageId String
  externalThreadId  String?
  workItemId        String?
  subject           String
  sender            String
  recipients        Json?
  sentAt            DateTime?
  snippet           String?
  bodyText          String?
  bodyHtml          String?
  sourceUrl         String?
  status            String    @default("imported")
  matchConfidence   Int?
  matchEvidence     Json?
  identifiers       Json?
  location          Json?
  rawMetadata       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id])
  workItem    RosObject?                @relation(fields: [workItemId], references: [id])
  attachments CommunicationAttachment[]
  reviewItem  CommunicationReviewItem?

  @@unique([workspaceId, source, externalMessageId])
  @@index([workspaceId, workItemId])
  @@index([workspaceId, status])
  @@index([externalThreadId])
}

model CommunicationAttachment {
  id                   String   @id @default(cuid())
  communicationId      String
  externalAttachmentId String?
  fileName             String
  mimeType             String?
  sizeBytes            Int?
  sourceUrl            String?
  storageUrl           String?
  checksum             String?
  metadata             Json?
  createdAt            DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([communicationId, externalAttachmentId])
  @@index([communicationId])
}

model CommunicationReviewItem {
  id                  String    @id @default(cuid())
  workspaceId         String
  communicationId     String    @unique
  suggestedWorkItemId String?
  category            String
  reason              String
  status              String    @default("open")
  confidence          Int?
  evidence            Json?
  resolvedById        String?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace         Workspace     @relation(fields: [workspaceId], references: [id])
  communication     Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  suggestedWorkItem RosObject?    @relation("suggestedWorkItem", fields: [suggestedWorkItemId], references: [id])

  @@index([workspaceId, status])
  @@index([suggestedWorkItemId])
}

model ImportCheckpoint {
  id           String    @id @default(cuid())
  workspaceId  String
  source       String
  mailbox      String
  label        String    @default("")
  cursor       String?
  historyId    String?
  lastSyncedAt DateTime?
  status       String    @default("idle")
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, source, mailbox, label])
  @@index([workspaceId, source])
}
