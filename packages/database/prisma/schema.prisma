generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  type      String
  status    String   @default("active")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  roles             Role[]
  objects           RosObject[]
  events            TimelineEvent[]
  portalInvitations PortalInvitation[]
  auditEvents       AuditEvent[]
}

model User {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  email              String    @unique
  roleId             String?
  status             String    @default("active")
  authProvider       String?
  authProviderUserId String?
  mfaRequired        Boolean   @default(false)
  portalAccessStatus String    @default("active")
  lastLoginAt        DateTime?
  invitedAt          DateTime?
  deactivatedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace             Workspace          @relation(fields: [workspaceId], references: [id])
  role                  Role?              @relation(fields: [roleId], references: [id])
  sentPortalInvitations PortalInvitation[] @relation("PortalInvitationInviter")
  auditEvents           AuditEvent[]       @relation("AuditActor")

  @@unique([authProvider, authProviderUserId])
  @@index([workspaceId, status])
  @@index([workspaceId, portalAccessStatus])
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  users     User[]
}

model RosObject {
  id                  String    @id @default(cuid())
  workspaceId         String
  objectType          String
  name                String
  status              String
  health              String
  ownerId             String?
  clientUserId        String?
  clientObjectId      String?
  assignedStaffUserId String?
  backupStaffUserId   String?
  nextAction          String?
  data                Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  events      TimelineEvent[]
  sourceLinks ObjectRelationship[] @relation("source")
  targetLinks ObjectRelationship[] @relation("target")

  @@index([workspaceId, clientUserId])
  @@index([workspaceId, clientObjectId])
  @@index([workspaceId, assignedStaffUserId])
  @@index([workspaceId, backupStaffUserId])
}

model ObjectRelationship {
  id               String   @id @default(cuid())
  sourceObjectId   String
  targetObjectId   String
  relationshipType String
  createdAt        DateTime @default(now())

  sourceObject RosObject @relation("source", fields: [sourceObjectId], references: [id])
  targetObject RosObject @relation("target", fields: [targetObjectId], references: [id])
}

model TimelineEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  objectId      String
  actorId       String?
  eventType     String
  summary       String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  object    RosObject @relation(fields: [objectId], references: [id])
}

model Workflow {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  status       String
  triggerEvent String
  definition   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowId   String
  objectId     String
  status       String
  currentStage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

model Task {
  id              String    @id @default(cuid())
  workspaceId     String
  relatedObjectId String?
  ownerId         String?
  title           String
  status          String
  priority        String
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AutomationRule {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  triggerEvent   String
  conditions     Json
  actions        Json
  requiresReview Boolean  @default(false)
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String?
  relatedObjectId String?
  level           String
  title           String
  message         String
  status          String
  dueAt           DateTime?
  createdAt       DateTime  @default(now())
}

model Document {
  id              String   @id @default(cuid())
  workspaceId     String
  relatedObjectId String?
  ownerId          String?
  uploadedByUserId String?
  fileName        String
  fileUrl         String
  storageKey      String?
  fileSizeBytes   Int?
  mimeType        String?
  documentType    String
  status          String
  requestedAction String?
  notes           String?
  accessLevel     String   @default("client_and_staff")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, documentType])
  @@index([relatedObjectId])
}

model Invoice {
  id              String    @id @default(cuid())
  workspaceId     String
  clientObjectId  String
  relatedObjectId String?
  packageObjectId String?
  amount          Decimal
  status          String
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
}

model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  invoiceId   String
  amount      Decimal
  status      String
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model PortalInvitation {
  id                   String    @id @default(cuid())
  workspaceId          String
  email                String
  name                 String?
  roleName             String
  status               String    @default("pending")
  provider             String    @default("clerk")
  providerInvitationId String?
  invitedByUserId      String?
  clientObjectId       String?
  serviceContext       Json?
  expiresAt            DateTime?
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  invitedBy User?     @relation("PortalInvitationInviter", fields: [invitedByUserId], references: [id])

  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([provider, providerInvitationId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  actorEmail  String?
  action      String
  subjectType String
  subjectId   String?
  summary     String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([subjectType, subjectId])
}
