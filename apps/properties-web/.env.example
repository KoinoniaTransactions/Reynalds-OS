# Public-site canonical URL (only configured environments are indexed)
NEXT_PUBLIC_PROPERTIES_SITE_URL=

# Turn on only after an approved end-to-end test with verified recipient.
# Both flags must be true for the on-site form and API to function.
NEXT_PUBLIC_PROPERTIES_INQUIRIES_ENABLED=false
PROPERTIES_INQUIRIES_ENABLED=false

# Resend sender must belong to an authenticated, approved domain.
PROPERTIES_RESEND_API_KEY=
PROPERTIES_INQUIRY_FROM_EMAIL=
PROPERTIES_INQUIRY_TO_EMAIL=

# Cloudflare Turnstile site and secret keys, scoped to this environment hostname.
NEXT_PUBLIC_PROPERTIES_TURNSTILE_SITE_KEY=
PROPERTIES_TURNSTILE_SECRET_KEY=

# Exact https://origin of the website hosting this form, without trailing slash.
PROPERTIES_INQUIRY_ALLOWED_ORIGIN=

# RentCast rental valuation. Never expose the API key in NEXT_PUBLIC variables.
RENTCAST_API_KEY=
PROPERTIES_RENTCAST_ENABLED=false
NEXT_PUBLIC_PROPERTIES_RENTCAST_ENABLED=false
